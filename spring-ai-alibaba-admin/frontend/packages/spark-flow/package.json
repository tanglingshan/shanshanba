{
  "name": "@spark-ai/flow",
  "version": "0.0.13",
  "description": "A powerful and flexible flow canvas rendering engine designed for AI applications. Provides comprehensive workflow visualization and interaction capabilities for platforms like Dify and Bailian, enabling seamless creation and management of complex AI agent workflows with an intuitive drag-and-drop interface.",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:css": "tailwindcss -i ./tailwind.css -o ./dist/index.css --minify",
    "build:copy": "copyfiles ./tailwind.css ./dist/tailwind.css",
    "build:replace": "node -e \"const fs=require('fs'); const content=fs.readFileSync('./dist/index.js','utf8'); fs.writeFileSync('./dist/index.js', content.replace('../tailwind.css', './index.css'));\"",
    "build": "father build && pnpm run build:css && pnpm run build:copy && pnpm run build:replace",
    "build:watch": "father dev",
    "dev": "dumi dev && father dev",
    "docs:build": "dumi build",
    "docs:preview": "dumi preview",
    "doctor": "father doctor",
    "prepublishOnly": "father doctor && pnpm run build",
    "start": "pnpm run dev"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/view": "^6.9.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@spark-ai/design": "^1.0.3",
    "@uiw/codemirror-theme-vscode": "^4.23.10",
    "@uiw/react-codemirror": "4.20.2",
    "@xyflow/react": "12.3.5",
    "ahooks": "3.8.1",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "elkjs": "^0.9.3",
    "lodash-es": "^4.17.21",
    "use-bus": "^2.5.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.1",
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@types/hoist-non-react-statics": "^3.3.7",
    "@types/invariant": "^2.2.37",
    "@types/is-hotkey": "^0.1.10",
    "@types/jsonfile": "^6.1.4",
    "@types/katex": "^0.16.8",
    "@types/lodash": "^4.17.25",
    "@types/lodash-es": "^4.17.12",
    "@types/mdast": "^4.0.4",
    "@types/minimatch": "^6.0.0",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.4.0",
    "@types/normalize-package-data": "^2.4.4",
    "@types/parse5": "^7.0.0",
    "@types/prop-types": "^15.7.15",
    "@types/ramda": "^0.32.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/resolve": "^1.20.6",
    "@types/sax": "^1.2.7",
    "@types/stylis": "^4.2.7",
    "@types/unist": "^3.0.3",
    "@types/use-sync-external-store": "^1.5.0",
    "@umijs/plugins": "^4.3.8",
    "antd": "5.23.2",
    "dumi": "^2.4.13",
    "father": "^4.1.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwindcss": "^3.4.15"
  },
  "peerDependencies": {
    "antd": "5.23.2",
    "react": ">=16.9.0",
    "react-dom": ">=16.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "authors": []
}
